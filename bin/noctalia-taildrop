#!/usr/bin/env python3
"""noctalia-taildrop — send a file to a device via the Tailscale plugin picker.

Invoked from a file manager (e.g. HyprFM) with a single file path (substituted
for %f). Validates the file, then hands it to the Tailscale plugin (Noctalia) as
a structured send request so the user picks a destination before anything is
sent. No shell is used so paths with spaces / quotes / newlines stay intact.

Exit codes: 0 dispatched, 1 local validation/runtime error.
"""
import json
import os
import subprocess
import sys
import uuid

PLUGIN_ENTRY = "davemhammer/tailscale:service"
EVENT = "taildrop_send"
MAX_PATH = 4096


def fail(msg):
    print(f"noctalia-taildrop: {msg}", file=sys.stderr)
    return 1


def main(argv):
    if len(argv) != 2:
        return fail("usage: noctalia-taildrop <absolute-file-path>")
    raw = argv[1]

    path = os.path.abspath(raw)
    if path != raw and not os.path.isabs(raw):
        return fail(f"path is not absolute: {raw}")
    if len(path) > MAX_PATH:
        return fail("path too long")
    if not os.path.exists(path):
        return fail(f"not found: {path}")
    if not (os.path.isfile(path) or os.path.isdir(path)):
        return fail(f"not a file or folder: {path}")
    if not os.access(path, os.R_OK):
        return fail(f"not readable: {path}")

    payload = {
        "v": 1,
        "requestId": str(uuid.uuid4()),
        "paths": [path],
        "origin": "hyprfm",
    }
    cmd = ["noctalia", "msg", "plugin", PLUGIN_ENTRY, "all", EVENT, json.dumps(payload)]
    try:
        r = subprocess.run(cmd, check=False, capture_output=True, text=True)
    except FileNotFoundError as exc:
        return fail(f"cannot run 'noctalia': {exc}")
    if r.returncode != 0:
        detail = (r.stderr or r.stdout or "").strip()
        return fail(f"dispatch failed: {detail or r.returncode}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
